  "status_product_cap": 2.5,
  "hit_zones": {
    "body": {
      "damage": 1.0,
      "restraint": 1.0
    },
    "limb": {
      "damage": 0.7,
      "restraint": 0.7
    },
    "weak_point": {
      "damage": 2.5,
      "restraint": 2.0
    }
  },
  "ambush": {
    "damage_multiplier": 1.8,
    "restraint_multiplier": 1.5,
    "requires": "target_unaware"
  },
  "formulas": {
    "damage": "base_damage * ammo_damage_multiplier * element_multiplier * hit_zone_damage * (1 - armour_reduction) * ambush_multiplier",
    "restraint_gain": "weapon_base_restraint * ammo_restraint_multiplier * element_multiplier * hit_zone_restraint * status_product * wound_multiplier * ambush_multiplier / size_resistance",
    "wound_multiplier": "1.0 + 2.0 * (1 - current_hp / max_hp)",
    "restraint_required": "species_base_restraint * size_restraint_multiplier * (1 + 0.15 * evolution_stage) * restraint_required_scale",
    "restraint_decay_per_second": "4.0 + 0.35 * species_tier",
    "flee_chance_per_second": "skittishness * (1 - restraint / restraint_required)",
    "weak_point_damage_note": "A weak point hit uses the weapon's crit_multiplier in place of hit_zones.weak_point.damage; the hit_zones value is the default for weapons that do not define one.",
    "restraint_decay_note": "Statuses scale decay: a status with halts_restraint_decay stops it entirely, otherwise decay_multiplier values multiply together."
  },
  "subdue_window_seconds": 5,
  "failed_subdue": {
    "restraint_retained": 0.5,
    "applies": "enraged"
  },
  "restraint_required_scale": 3.0,
  "$restraint_required_scale_note": "Converts between two independently authored ladders: weapon `restraint` (14-58 per projectile) and species `base_restraint` (22-1100). Without it a sedated weak-point dart on a wounded Strider fills the whole bar in one shot. Raise it to make every capture slower; it is the single global dial for capture pacing."
}
